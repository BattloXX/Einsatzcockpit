[Unit]
Description=Einsatzcockpit FF Wolfurt
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=exec
User=clp-einsatz
Group=clp-einsatz
WorkingDirectory=/home/clp-einsatz/htdocs/einsatzleiter
EnvironmentFile=/home/clp-einsatz/htdocs/einsatzleiter/.env
ExecStart=/home/clp-einsatz/htdocs/einsatzleiter/.venv/bin/gunicorn \
    -k uvicorn.workers.UvicornWorker \
    -w 1 \
    --bind 127.0.0.1:8092 \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    app.main:app
# Worker-Hinweis: SMS-Gateway-Sockets leben pro Gunicorn-Worker. Der SMS-Versand sieht
# auch mit Redis nur die Gateways des eigenen Workers; Alarm-SMS brauchen daher -w 1.
# Hintergrund-Loops (DIBOS, LIS, Alarm-Outbox, SMS-Nachversand) laufen via Leader-Lock
# nur in einem Worker (LEADER_LOCK_PATH, Standard app_storage/background-leader.lock).
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=einsatzleiter

[Install]
WantedBy=multi-user.target
