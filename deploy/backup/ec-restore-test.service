[Unit]
Description=Einsatzcockpit Restore-Probe (spielt den neuesten Dump testweise ein)
After=network.target mariadb.service
Wants=mariadb.service
# Optionaler Fehler-Hook, nur Beispiel fuer ein lokales Drop-in unter [Unit]:
# OnFailure=ec-backup-failure@%n.service
# Eigene Alarmierungs-Unit mit systemd-cat oder Mail einrichten und testen.
# Beispiel und Grenzen: Wiki Betrieb-Backup-und-Disaster-Recovery, Monitoring.

[Service]
Type=oneshot
UMask=0077
User=clp-einsatz
Group=clp-einsatz
WorkingDirectory=/home/clp-einsatz/htdocs/einsatzleiter
EnvironmentFile=/home/clp-einsatz/htdocs/einsatzleiter/.env
# Der DB-Benutzer braucht CREATE/DROP auf die Wegwerf-DB
# (Standard: einsatzleiter_restore_test und einsatzleiter_restore_test_weather).
# Siehe Runbook, Abschnitt "Restore-Probe".
ExecStart=/home/clp-einsatz/htdocs/einsatzleiter/.venv/bin/python -m app.cli restore-test

[Install]
WantedBy=multi-user.target
