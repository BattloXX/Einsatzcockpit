# Docker Compose liest diese Datei als .env im Repository-Root.
# Sichere Zufallswerte erzeugen, keine Beispielpasswoerter produktiv verwenden.

# Tag des GHCR-Images (siehe Installation-Docker.md, Option A). "latest" = letzter
# Stand von main; fuer ein festes Release z.B. v2026.08.17 setzen. Nur fuer docker compose
# pull/up relevant, wird bei lokalem Build (--build) ignoriert.
IMAGE_TAG=latest

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=einsatzleiter
MARIADB_USER=einsatzleiter
MARIADB_PASSWORD=

DATABASE_URL=mysql+pymysql://einsatzleiter:PASSWORT@db:3306/einsatzleiter
REDIS_URL=redis://redis:6379/0

SECRET_KEY=
FERNET_KEY=
COOKIE_SECURE=true
APP_HOST=0.0.0.0
APP_PORT=8092
APP_BASE_URL=https://einsatzcockpit.example.at
PUBLIC_BASE_URL=
DEBUG=false
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

MEDIA_STORAGE_DIR=app_storage/incident_media
OBJEKT_MEDIA_DIR=app_storage/objekt_media
NACHSCHLAGEWERK_DATA_DIR=app_storage/nachschlagewerk
BACKUP_DIR=app_storage/backups

# Optionaler lesender GitHub-Abgleich fuer Admin-MCP (ohne Token eingeschraenkt).
# Fine-grained Token: nur Contents/Actions/Pull requests = Read, nur dieses Repo.
# Token nie committen; alle 90 Tage rotieren und nur in docker.env/.env hinterlegen.
# GitHub-Lesetoken bevorzugt unter System > Einstellungen > GitHub-Zugang speichern.
# Diese Umgebungsvariable bleibt Fallback, solange kein DB-Token hinterlegt ist.
GITHUB_READ_TOKEN=
GITHUB_REPOSITORY=BattloXX/Einsatzcockpit
GITHUB_API_TIMEOUT_S=8.0
