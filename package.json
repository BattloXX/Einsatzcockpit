{
  "name": "einsatzcockpit-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind build pipeline fuer das Einsatzcockpit-Frontend. Reine Dev-Dependency; das Ergebnis (app/static/css/app.css) wird ins Repo committed, sodass Deploy ohne Node funktioniert.",
  "scripts": {
    "build": "tailwindcss -i ./app/static/css/tailwind.input.css -o ./app/static/css/app.css --minify",
    "dev": "tailwindcss -i ./app/static/css/tailwind.input.css -o ./app/static/css/app.css --watch",
    "test:js": "node --test tests/js/*.test.mjs",
    "vendor": "node scripts/vendor-js.mjs",
    "vendor:check": "node scripts/vendor-js.mjs --check"
  },
  "devDependencies": {
    "@geoman-io/leaflet-geoman-free": "2.20.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "alpinejs": "3.17.4",
    "chart.js": "4.5.1",
    "fake-indexeddb": "^6.2.5",
    "htmx.org": "2.0.11",
    "konva": "10.9.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lib0": "0.2.119",
    "quill": "2.0.3",
    "quill-cursors": "5.0.0",
    "sortablejs": "1.15.7",
    "tailwindcss": "^3.4.0",
    "y-protocols": "1.0.7",
    "y-quill": "1.0.0",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "overrides": {
    "y-quill": {
      "quill-cursors": "$quill-cursors"
    }
  }
}
