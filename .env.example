# ─── Datenbank ────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://einsatzleiter:PASSWORT@127.0.0.1:3306/einsatzleiter
# Verbindungen je Worker; bei mehreren Workern Budget laut Rollout-Doku reduzieren.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30
# Optional: MariaDB-Limit fuer die Startwarnung im Gunicorn-Multi-Worker-Vorschlag.
DB_MAX_CONNECTIONS=151

# ─── Session / Sicherheit ─────────────────────────────────────────────
# Pflicht: min. 32 Zeichen, langer zufälliger String. Erzeugen z.B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_MAX_AGE_SECONDS=86400
SESSION_INACTIVITY_SECONDS=28800
# PFLICHT in Produktion (DEBUG=false): true, sonst bricht der App-Start hart ab
# (validate_startup_secrets() in app/config.py). In Produktion IMMER auf true,
# da HTTPS via nginx vorausgesetzt wird.
COOKIE_SECURE=false

# App per <iframe> auf externen (vertrauenswürdigen) Seiten einbettbar machen
# (CSP frame-ancestors, app-weit — z.B. Wetter-/Dashboard-Kacheln auf
# eus.fwwo.at, Fahrtenbuch auf feuerwehr.wolfurt.at). Leerzeichen-getrennte
# Liste erlaubter Eltern-Origins, Wildcard-Subdomain wie "https://*.fwwo.at"
# erlaubt. Leer = Einbettung nur same-origin (striktester Fallback).
TRUSTED_FRAME_ANCESTORS=https://feuerwehr.wolfurt.at https://*.fwwo.at

# ─── Reverse-Proxy (X-Forwarded-For) ──────────────────────────────────
# X-Forwarded-For/-Proto werden nur akzeptiert, wenn die Verbindung von einer
# der TRUSTED_PROXY_IPS kommt (Default: localhost, passend zu nginx auf
# demselben Host, siehe deploy/nginx-snippet.conf). Läuft die App OHNE
# vorgelagerten Proxy direkt am Netz: TRUST_PROXY_HEADERS=false setzen —
# sonst wäre die Client-IP für Rate-Limits/Audit-Logs per Header fälschbar.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Overpass: Primaerendpunkte und oeffentliche Ausweichinstanzen laut OSM-Wiki.
HYDRANT_OVERPASS_URL=https://overpass-api.de/api/interpreter
STRASSEN_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Kommagetrennt, nur HTTPS; leer = kein Fallback. Per Env ueberschreibbar.
# kumi.systems ist derselbe Host wie private.coffee.
OVERPASS_FALLBACK_URLS=https://overpass.private.coffee/api/interpreter
# Lokale Gebaeude: kommagetrennte Liste name=https://... (nur geschlossene Ways).
# Geofabrik: Oesterreich nur als Gesamtland, deutlich mehr RAM:
# OSM_GEBAEUDE_QUELLEN=oesterreich=https://download.geofabrik.de/europe/austria-latest.osm.pbf
OSM_GEBAEUDE_IMPORT_ENABLED=true
OSM_GEBAEUDE_QUELLEN=vorarlberg=https://download.openstreetmap.fr/extracts/europe/austria/vorarlberg-latest.osm.pbf
OSM_GEBAEUDE_AKTUALISIERUNG_TAGE=7
OSM_GEBAEUDE_MAX_ALTER_TAGE=30
OSM_GEBAEUDE_MAX_DOWNLOAD_MB=1200
OSM_GEBAEUDE_MAX_AENDERUNG_ANTEIL=0.2
OSM_GEBAEUDE_DATA_DIR=app_storage/osm
OVERPASS_ENDPUNKT_FEHLER=2
OVERPASS_ENDPUNKT_FENSTER_SECONDS=300
OVERPASS_ENDPUNKT_PAUSE_SECONDS=300
# Gebaeudeumrisse: eigenes Budget, unabhaengig vom globalen Hydranten-Breaker.
OBJEKT_GEBAEUDE_TIMEOUT_SECONDS=25.0
OBJEKT_GEBAEUDE_TOTAL_TIMEOUT_SECONDS=45.0

# ─── App ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8092
APP_BASE_URL=https://einsatzcockpit.com
PROBE_MEDIA_DIR=app_storage/probe_media
# Öffentliche URL für Mail-Links (Passwort-Reset etc.). Leer = APP_BASE_URL
PUBLIC_BASE_URL=
# Optionale Kurz-Domain für SMS-Links (z. B. https://ec.at), muss auf dieselbe App zeigen. Leer = PUBLIC_BASE_URL
SHORT_BASE_URL=

# Alarm-Rohbytes: Aufbewahrung in Tagen, 0 = aus; Text/Parsed/Journal bleiben.
ALARM_RAW_BYTES_RETENTION_DAYS=365
# Android-Release-Repository und Dateipräfix der Auto-Update-APK für /app/android
ANDROID_APP_REPO=BattloXX/Einsatzcockpit-Android
ANDROID_APK_PRAEFIX=einsatzcockpit-autoupdate-v
# Gültigkeit einer Einladung zum Festlegen des Passworts in Stunden
INVITE_TTL_HOURS=168
DEBUG=false
# Testsystem-Modus: Zeigt einen deutlichen "TEST SYSTEM" Hinweis im Header und auf Ausdrucken
TEST_SYSTEM=false
# Slow-Query-Logging: Queries oberhalb dieser Schwelle (ms) als WARNING loggen
# (Logger "einsatzleiter.slow_query", auch in der Sysadmin-Log-Ansicht). 0 = aus.
SLOW_QUERY_LOG_MS=300
# CSP-Messung: zusätzlich Content-Security-Policy-Report-Only ohne 'unsafe-inline' für
# Scripts; Verstöße landen aggregiert im Log (Logger "einsatzleiter.csp"). Nichts wird blockiert.
CSP_REPORT_ONLY=false

# ─── Routing für die Einsatz-Anfahrt ──────────────────────────────────
# Opt-in: Einsatzkoordinaten werden an den gewählten externen Routingdienst gesendet.
# ors unterstützt Sperrflächen und benötigt beim öffentlichen Standarddienst einen API-Key.
EINSATZ_ROUTING_ENABLED=false
EINSATZ_ROUTING_PROVIDER=ors
# Leer: ORS -> https://api.openrouteservice.org, OSRM -> ROUTING_OSRM_URL aus app/config.py
EINSATZ_ROUTING_API_URL=
EINSATZ_ROUTING_API_KEY=
# Leer: ORS -> driving-car, OSRM -> driving
EINSATZ_ROUTING_PROFILE=
EINSATZ_ROUTING_TIMEOUT_SECONDS=5
MAIL_ZUORDNUNG_LOOP_ENABLED=true
MAIL_ZUORDNUNG_LOOP_INTERVAL_S=30

# ─── Redis Pub/Sub-Bus (worker-übergreifende WebSockets) ──────────────────
# PFLICHT bei mehreren Workern (gunicorn -w 2+, siehe deploy/einsatzleiter.service):
# ohne Redis erreichen Live-Broadcasts UND Gateway-Druckaufträge nur den Worker,
# der den jeweiligen Socket hält → Stationsdruck schlägt worker-abhängig fehl.
# Zusätzlich zählen Rate-Limits (Login, API, Uploads) nur mit Redis worker-
# übergreifend — ohne teilt sich das Limit NICHT, jeder Worker hat ein eigenes
# Kontingent (effektiv Limit × Workerzahl).
# Leer lassen ist nur bei -w 1 korrekt.
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Web Push (VAPID) ─────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# ─── Spam-Schutz Kontaktformular (Cloudflare Turnstile) ───────────
# Keys unter dash.cloudflare.com über Turnstile anlegen (Widget-Typ "Managed"
# oder unsichtbar) und die Domain einsatzcockpit.com eintragen.
# Leer lassen = Formular läuft ohne CAPTCHA (nur Honeypot, Rate-Limit und URL-Filter).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Erster Admin (nur beim ersten Start ausgewertet) ─────────────────
# Wenn BOOTSTRAP_ADMIN_PASSWORD leer ist, wird beim ersten Start ein
# zufälliges Passwort generiert und einmalig in den Log geschrieben.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ─── PDF ──────────────────────────────────────────────────────────────
PDF_LOGO_PATH=app/static/img/logo.png

# ─── SMTP / Mail (für Passwort-Reset) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=einsatzleiter@feuerwehr-wolfurt.at
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# SMS-Versand je Organisation ueber EUS Message Send API
EUS_SMS_ENABLED=true
EUS_SMS_HTTP_TIMEOUT=15
EUS_SMS_TOKEN_MARGIN_S=60
API_MESSAGE_RATELIMIT=20/minute
API_MESSAGE_MAX_RECIPIENTS=200
API_SMS_SYNC_MAX_RECIPIENTS=20
API_SMS_DAILY_LIMIT=500
API_MAIL_DAILY_LIMIT=2000
MAIL_INBOUND_DOMAIN=get.einsatzcockpit.com
API_MESSAGE_MAX_BODY_CHARS=10000
PASSWORD_RESET_TTL_MIN=30

# ─── Login-Lockout ────────────────────────────────────────────────────
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15

# ─── Fernet-Verschlüsselung ───────────────────────────────────────────
# PFLICHT in Produktion (DEBUG=false): ohne eigenen Key bricht der App-Start
# hart ab (validate_startup_secrets() in app/config.py, seit 2026-07-01).
# Grund: leer würde den Datenschlüssel aus SHA256(SECRET_KEY) ableiten, wodurch
# eine spätere SECRET_KEY-Rotation gespeicherte SSO-Client-Secrets/KI-API-Keys
# unentschlüsselbar macht. Eigener Key ist außerdem unabhängig rotierbar.
# Generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── GSL-Zugangslinks (Gruppenkommandanten-/QR-Zugang) ────────────────
# Geheimer Schlüssel, aus dem die Zugangslinks abgeleitet werden (nur der Hash liegt in der DB).
# Leer = Ableitung aus SECRET_KEY (läuft, aber eine SECRET_KEY-Rotation entwertet alle Links).
# Ein Wechsel dieses Schlüssels macht ausgegebene Links ungültig.
# Generieren: python -c "import secrets; print(secrets.token_urlsafe(48))"
GSL_ZUGANG_KEY=

# ─── SSO / Microsoft Entra ID ────────────────────────────────────────
# Globaler Killswitch. Verbindungsdaten (Tenant ID, Client ID, Secret)
# werden je Organisation im Tool selbst unter Admin -> SSO konfiguriert.
SSO_ENABLED=true
# MS_LOGIN_BASE_URL=https://login.microsoftonline.com  # nur für Sovereign Clouds ändern
# SSO_HTTP_TIMEOUT=10
# SSO_FLOW_MAX_AGE=600
# SSO_JWKS_CACHE_TTL=3600

# ─── In-App-Update-Mechanismus ────────────────────────────────────────
# Wenn true, muss beim ZIP-Upload der SHA256 des Releases angegeben werden
UPDATE_ZIP_REQUIRE_HASH=true

# ─── Nachschlagewerke (Gefahrgut / Rettungskarten) ────────────────────────
# Persistentes Verzeichnis fuer gesyncte Daten (ausserhalb des read-only Repos).
NACHSCHLAGEWERK_DATA_DIR=app_storage/nachschlagewerk
# Taeglicher Sync (03:00) fuer Gefahrgut UND Rettungskarten-Katalog. false = aus.
NACHSCHLAGEWERK_SYNC_ENABLED=true
# Quelle der vollstaendigen BAM/ADR-Gefahrgut-Daten (dl-de/by-2.0). Akzeptiert eine
# direkte ;-getrennte CSV ODER ein ZIP (z. B. BAM-Download mit BAM-Gefahrgutdaten.csv +
# -status.csv; das Datenblatt wird automatisch entpackt/erkannt). Leer = Seed bleibt.
NACHSCHLAGEWERK_GEFAHRGUT_URL=
# Katalog verfuegbarer Rettungskarten (Euro NCAP / CTIF "Euro Rescue"): offene, fuer
# Einsatzkraefte frei bereitgestellte JSON-API mit >2000 Modellen inkl. deutscher PDFs.
# Taeglich gesynct (nur Verzeichnis; PDFs erst beim Oeffnen offline gecacht). Leer = aus.
NACHSCHLAGEWERK_RETTUNGSKARTEN_KATALOG_URL=https://api.rescue.euroncap.com/euro-rescue/variants
# Zusaetzliche On-demand-Direktquelle fuer Modelle ausserhalb des Katalogs bzw. eine
# eigene lizenzierte Sammlung. URL-Template mit {hersteller}/{modell} (urlsafe). Leer = aus.
NACHSCHLAGEWERK_RETTUNGSKARTEN_URL_TEMPLATE=

# ─── Datenbank-Backup + Restore-Probe ─────────────────────────────────────
# python -m app.cli backup  /  restore-test  (systemd-Timer in deploy/backup/).
# Runbook: docs/wiki/Betrieb-Backup-und-Disaster-Recovery.md
# Zielverzeichnis der Dumps (persistent; zusaetzlich Offsite spiegeln, 3-2-1-Regel).
BACKUP_DIR=app_storage/backups
# So viele der neuesten Dumps je DB/Medien behalten.
BACKUP_KEEP_DAILY=14
# Medien (app_storage) mitsichern.
BACKUP_INCLUDE_MEDIA=true
# MariaDB-Client-Binaries (ggf. absoluter Pfad).
BACKUP_DUMP_BIN=mariadb-dump
BACKUP_CLIENT_BIN=mariadb
# Wegwerf-DB der Restore-Probe (darf NIE die Produktions-DB sein). Der DB-User
# braucht CREATE/DROP darauf (siehe Runbook, Abschnitt "Restore-Probe").
BACKUP_RESTORE_TEST_DB=einsatzleiter_restore_test

# ─── Off-Site-Upload der Backups (3-2-1-Regel) ────────────────────────────
# Nach jedem `app.cli backup` automatisch an eine Gegenstelle schieben; separat
# testbar via `app.cli backup-upload`. true = aktiv.
BACKUP_REMOTE_ENABLED=false
# Protokoll: sftp | scp | rsync | ftp | ftps | rclone
#  sftp/scp/rsync = SSH (Key-Auth, sicher, empfohlen) · ftps = FTP+TLS
#  ftp = UNVERSCHLUESSELT (nur LAN!) · rclone = S3/WebDAV/Backblaze/GDrive/...
BACKUP_REMOTE_PROTOCOL=sftp
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PORT=0                 # 0 = Standard (22 bzw. 21)
BACKUP_REMOTE_USER=
BACKUP_REMOTE_PASSWORD=              # NUR fuer ftp/ftps (SSH nutzt Key)
BACKUP_REMOTE_KEY=                   # Pfad zum privaten SSH-Key (sftp/scp/rsync)
BACKUP_REMOTE_PATH=                  # Zielverzeichnis auf der Gegenstelle
# SSH-Hostkey-Pruefung: accept-new (TOFU) | yes (strikt, known_hosts) | no
BACKUP_REMOTE_SSH_STRICT=accept-new
# rclone: Remote-Name inkl. Doppelpunkt (z. B. "offsite:" oder "s3:bucket")
BACKUP_REMOTE_RCLONE_REMOTE=
# Nur die neuesten Dumps je Typ hochladen (true) oder alle im BACKUP_DIR (false)
BACKUP_REMOTE_ONLY_LATEST=true
# Binaries (ggf. absoluter Pfad)
BACKUP_REMOTE_SCP_BIN=scp
BACKUP_REMOTE_SFTP_BIN=sftp
BACKUP_REMOTE_RSYNC_BIN=rsync
BACKUP_REMOTE_RCLONE_BIN=rclone

# ─── Self-Service-Backup je Organisation ──────────────────────────────────
# Jede Org sichert ihre eigenen (tenant-gescopten) Daten selbst: Download oder
# geplanter Push an ein selbst konfiguriertes Ziel (SFTP/SCP/rsync/FTP/FTPS/rclone).
# Restore in eine neue Org ist eine system_admin-Aktion. Konfiguration je Org unter
# /admin/org-backup. Runbook: docs/wiki/Administration-Org-Datensicherung.md
# Globaler Kill-Switch (false = Modul komplett aus).
ORG_BACKUP_ENABLED=true
# Groessenlimit je Org-Archiv (Schutz vor Ueberlast; 0 = unbegrenzt).
ORG_BACKUP_MAX_BYTES=2147483648
# Intervall (Sekunden), in dem faellige geplante Org-Backups geprueft werden.
ORG_BACKUP_LOOP_INTERVAL_S=900

# ─── KI-Integration (Anthropic Claude) ───────────────────────────────────
# Aktivierung: AI_ENABLED=true + gültiger API-Key → KI-Funktionen sichtbar.
# Standardmäßig deaktiviert; bewusst pro Instanz einschalten.
ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_MODEL_DEFAULT=claude-sonnet-4-6
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MAX_TOKENS=1500
AI_TIMEOUT=20

# ─── Firebase Cloud Messaging (native Android Push) ───────────────────
# FCM_ENABLED=true aktiviert den zweiten Push-Kanal neben VAPID.
# FCM_PROJECT_ID: Firebase Project-ID (z.B. "einsatzleiter-12345")
# FCM_CREDENTIALS_PATH: Absoluter Pfad zur Service-Account-JSON ausserhalb des Repos
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=/etc/einsatzleiter/fcm-service-account.json

# Resend wird ausschliesslich verschluesselt ueber die Admin-Oberflaeche
# (System-Einstellungen bzw. /admin/mail) konfiguriert und aktiviert. Es gibt
# bewusst keine Umgebungsvariable fuer den API-Key oder einen Enable-Schalter.
RESEND_HTTP_TIMEOUT=15

# ─── Lokale Wetterstation (Davis Vantage Pro 2 / Meteobridge) ──────────
# Separate DB fuer die Zeitreihe (eigener Pool, damit Einsatz-Funktionen Vorrang
# behalten und die operative DB nicht aufgeblaeht wird). Leer = Feature deaktiviert.
WEATHER_DATABASE_URL=mysql+pymysql://einsatzleiter:PASSWORT@127.0.0.1:3306/einsatzleiter_weather
# Ingest-Endpoint (Meteobridge-Push) global aktiv
WEATHER_STATION_INGEST_ENABLED=true
# Aufbewahrungsdauer der historischen Messwerte in Tagen (taegliche Loeschung)
WEATHER_READING_RETENTION_DAYS=365
# Mindestabstand zwischen zwei akzeptierten Pushes je Station (Sekunden)
WEATHER_INGEST_MIN_INTERVAL_S=60

# Zentrale Suche: zusaetzlich Org-Schalter unter Einstellungen erforderlich.
# Systemweite Freigabe (false: Suchrouten 404, Menue ausgeblendet).
SEARCH_ENABLED=true
# Leader-Worker fuer Outbox und Neuaufbau.
SEARCH_INDEX_WORKER_ENABLED=true
# Zusaetzlicher Quellenabgleich im angegebenen Minutenintervall.
SEARCH_ABGLEICH_MINUTEN=60
# Lesendes MCP-Suchwerkzeug, zusaetzlich zur systemweiten/Org-Freigabe.
SEARCH_MCP_ENABLED=true
# Reserviert fuer die noch nicht umgesetzte semantische Stufe.
SEARCH_SEMANTIC_ENABLED=false
# Eigener Ollama-Host und Embedding-Modell.
# SEARCH_EMBED_URL=http://localhost:11434
# SEARCH_EMBED_MODEL=embeddinggemma
# Zieldimension nach Matryoshka-Kuerzung und L2-Normalisierung.
# SEARCH_EMBED_DIM=768
# Timeouts fuer einzelne Suchanfragen und Dokument-Batches (Sekunden).
# SEARCH_EMBED_QUERY_TIMEOUT_S=2.0
# SEARCH_EMBED_BATCH_TIMEOUT_S=60.0
# Dokumente pro Embedding-Request.
# SEARCH_EMBED_BATCH=16
# Maximale Cosinus-Distanz fuer semantische Treffer.
# SEARCH_SEMANTIC_MAX_DISTANZ=0.6

# Wetter: optionaler gemeinsamer Cache über REDIS_URL (sonst lokal, fail-open).
WEATHER_CACHE_TTL_CURRENT=300
WEATHER_CACHE_TTL_NOWCAST=300
WEATHER_CACHE_TTL_NWP=1800
WEATHER_CACHE_TTL_WARN=300
WEATHER_DAILY_TTL=3600
# Alternativer Env-Name: WEATHER_CACHE_TTL_DAILY=3600 (WEATHER_DAILY_TTL hat Vorrang)
WEATHER_HTTP_TIMEOUT=8
# Zusätzliche Versuche: 0–2; nur Timeout, Verbindungsfehler, HTTP 5xx.
WEATHER_HTTP_RETRIES=1
WEATHER_RETRY_BACKOFF_S=0.5
# Worker-Sperre und maximales Wartebudget; Fetch-Budget = 90 % davon.
WEATHER_LOCK_TTL_S=120

# Modellvergleich: Hinweis bei groesseren absoluten Abweichungen
WEATHER_COMPARE_WARN_PRECIP_MM=5
WEATHER_COMPARE_WARN_GUST_MS=5
